{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "@vizejs/vite-plugin"]
  },
  "contentMappers": [{ "package": "vize", "extensions": [".vue"] }],
  "include": ["src"]
}
